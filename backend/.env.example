# Server Environment Configuration
PORT=5000
NODE_ENV=development
DEMO_MODE=true

# Database: SQLite in Demo Mode, or PostgreSQL in Production
# Example PostgreSQL: postgresql://postgres:postgres@localhost:5432/khakhi_guard?schema=public
DATABASE_URL="file:./dev.db"

# JWT Secret
JWT_SECRET="khakhi_guard_classified_jwt_secret_key_2026_mha_i4c"
JWT_EXPIRES_IN="7d"

# Storage
STORAGE_TYPE="local" # "local" or "s3"
STORAGE_LOCAL_DIR="./uploads"

# Redis Queue (Optional in Demo Mode, uses In-Process Queue if unreachable)
REDIS_URL="redis://localhost:6379"

# External Integrations (Optional)
ETHERSCAN_API_KEY=""
OCR_ENGINE="regex"
